# ============================================================
# CoinDCX CS MCP Server — environment variable reference
# Copy to .env and fill in values (never commit .env to git).
# ============================================================

# ---- MCP HTTP server ----------------------------------------
MCP_HTTP_PORT=8080
MCP_HTTP_HOST=0.0.0.0

# ---- Admin API base URL (optional, default shown) -----------
# ADMIN_BASE_URL=https://admin-api.coindcx.com

# ---- CoinDCX API base URLs (optional, defaults shown) -------
# COINDCX_BASE_URL=https://api.coindcx.com
# COINDCX_PUBLIC_BASE_URL=https://public.coindcx.com

# ============================================================
# Audit Logs (MCP server — producer side)
# ============================================================
AUDIT_LOGS_ENABLED=false
AUDIT_KAFKA_BROKERS=localhost:9092
AUDIT_KAFKA_TOPIC=coindcx-cs-mcp-audit
AUDIT_KAFKA_CLIENT_ID=coindcx-cs-mcp

# ============================================================
# Audit Logs (audit-consumer — consumer + Postgres side)
# ============================================================
AUDIT_CONSUMER_GROUP=coindcx-cs-mcp-audit-consumer
AUDIT_DB_DSN=postgres://audit_user:secret@localhost:5432/auditdb?sslmode=disable
